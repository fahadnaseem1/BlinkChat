# For local Docker Compose only. Copy to .env; never commit the resulting .env file.
# The dev profile supports local HTTP. Render's Blueprint uses hosted + HTTPS instead.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
BLINK_ORIGIN=http://localhost:8080
BLINK_DATA_DIR=/data/blinkchat

# Required for Compose: paste a freshly generated value from: openssl rand -hex 32
# Keep the same value while reusing a database volume.
BLINK_DB_PASSWORD=
